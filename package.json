{
  "name": "pocket-friends",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare:character-art": "node scripts/prepare-painted-art.mjs",
    "check:character-art": "node scripts/check-painted-art.mjs",
    "build": "node scripts/check-cloud-env.mjs && tsc -b && vite build && node scripts/check-word-bundle.mjs && node scripts/check-effects-isolation.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:effects": "playwright test --config playwright.effects.config.ts",
    "check:effects-isolation": "node scripts/check-effects-isolation.mjs",
    "measure:effects": "node scripts/measure-effects-lab.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "3.15.1",
    "lucide-react": "^0.468.0",
    "pixi.js": "8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "0.34.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
